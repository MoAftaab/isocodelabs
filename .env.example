# Local demo defaults to SQLite. To use the Supabase PostgreSQL project,
# set DATABASE_URL in your private environment; never commit the actual URL.
DATABASE_URL=sqlite:///./instance/forgequote.db
APP_ENV=development
SESSION_SECRET=replace-with-a-random-local-secret
COOKIE_SECURE=false
TESSERACT_CMD=
OCR_LANGUAGE=eng
# Enter the client-approved GST percentage before issuing commercial quotes.
# The demo defaults to 0 and labels the tax line separately.
GST_RATE_PERCENT=0

# Private Supabase Storage for source files. Never use NEXT_PUBLIC_* for this key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=rfq-source-documents

# Optional OpenAI-compatible AgentRouter configuration.
# Add the provider-issued AI_API_KEY in your private environment only.
# Customer/NDA material is blocked from hosted inference until AI_NDA_APPROVED=true
# is set after the client has confirmed the provider's no-training terms.
AI_BASE_URL=https://agentrouter.org/v1
AI_PROTOCOL=openai
AI_MODEL=gpt-6.1-sol
AI_API_KEY=
AI_NDA_APPROVED=false
